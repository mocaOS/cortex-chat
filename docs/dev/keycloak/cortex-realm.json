{
  "realm": "cortex",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "cortex-chat",
      "name": "Cortex Chat (dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-secret-cortex-chat",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/oidc/callback",
        "http://localhost:3005/api/auth/oidc/callback",
        "http://localhost:3006/api/auth/oidc/callback"
      ],
      "webOrigins": ["+"],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email", "basic"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Verified",
      "credentials": [{ "type": "password", "value": "alice-password", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": false,
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Unverified",
      "credentials": [{ "type": "password", "value": "bob-password", "temporary": false }]
    },
    {
      "username": "carol",
      "email": "carol@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Carol",
      "lastName": "Linkable",
